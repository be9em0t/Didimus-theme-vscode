{
  "name": "didimus",
  "displayName": "Didimus",
  "description": "Fragrant Darkness",
  "version": "0.0.7",
  "publisher": "be9em0t",
  "repository": "https://github.com/be9em0t/Didimus-theme-vscode.git",
  "icon": "media/Didimus_Transparent.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "scripts": {
    "build:themes": "node ./scripts/render-theme-source.js ./themes/source/Didimus.source.js",
    "build:insiders": "node ./scripts/build-insiders.js"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "configurationDefaults": {
      "editor.fontFamily": "Source Code Pro"
    },
    "themes": [
      {
        "label": "Didimus",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-color-theme.json"
      },
      {
        "label": "Didimus Classic",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-classic-theme.json"
      },
      {
        "label": "Didimus Deep Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-deep-blue-color-theme.json"
      },
      {
        "label": "Didimus Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-blue-color-theme.json"
      },
      {
        "label": "Didimus Blue Sundown",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-blue-sundown-color-theme.json"
      },
      {
        "label": "Didimus Sundown",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-sundown-color-theme.json"
      },
      {
        "label": "Didimus Insiders",
        "uiTheme": "vs-dark",
        "path": "./themes/Didimus-insiders-color-theme.json"
      }
    ]
  }
}
